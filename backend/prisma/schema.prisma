generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  SELLER
  ADMIN
  STAFF
}

enum UserStatus {
  ACTIVE
  BANNED
}

enum ShopStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  HIDDEN
}

enum ShopOrderStatus {
  PENDING
  CONFIRMED
  SHIPPING
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  COD
  MOMO
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  tokenVersion Int @default(0)
  fullName     String
  phone        String?
  role         Role       @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  shop               Shop?
  addresses          Address[]
  cartItems          CartItem[]
  orders             Order[]
  reviews            Review[]
  refreshTokens      RefreshToken[]
  voucherRedemptions VoucherRedemption[]
  conversations      Conversation[]
  messages           Message[]
  notifications      Notification[]
  wishlist           WishlistItem[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Shop {
  id          String     @id @default(uuid())
  ownerId     String     @unique
  name        String
  description String?
  address     String?
  status      ShopStatus @default(PENDING)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  owner          User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  products       Product[]
  shopOrders     ShopOrder[]
  vouchers       Voucher[]
  conversations  Conversation[]
  advertisements Advertisement[]

  @@map("shops")
}

model Category {
  id       String     @id @default(uuid())
  name     String
  slug     String     @unique
  parentId String?

  parent   Category?  @relation("CategoryToParent", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryToParent")
  products Product[]

  @@map("categories")
}

model Product {
  id          String        @id @default(uuid())
  shopId      String
  categoryId  String?
  name        String
  slug        String        @unique
  description String?
  price       Decimal       @db.Decimal(12, 2)
  stock       Int           @default(0)
  status      ProductStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  shop       Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category   Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images     ProductImage[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  reviews    Review[]
  variants   ProductVariant[]
  wishlist   WishlistItem[]

  @@index([shopId])
  @@index([categoryId])
  @@map("products")
}

model ProductImage {
  id        String @id @default(uuid())
  productId String
  url       String
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model Address {
  id            String  @id @default(uuid())
  userId        String
  recipientName String
  phone         String
  line          String
  city          String
  isDefault     Boolean @default(false)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  variantId String
  quantity  Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([userId, variantId])
  @@map("cart_items")
}

model Order {
  id              String        @id @default(uuid())
  customerId      String
  addressId       String?
  recipientName   String
  recipientPhone  String
  shippingAddress String
  paymentMethod   PaymentMethod @default(COD)
  paymentStatus   PaymentStatus @default(PENDING)
  totalAmount     Decimal       @db.Decimal(12, 2)
  voucherCode     String?
  discountAmount  Decimal       @default(0) @db.Decimal(12, 2)
  checkoutKey     String?
  expiresAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customer           User                @relation(fields: [customerId], references: [id])
  address             Address?            @relation(fields: [addressId], references: [id], onDelete: SetNull)
  shopOrders          ShopOrder[]
  payment             Payment?
  voucherRedemptions  VoucherRedemption[]
  refunds             Refund[]
  paymentAttempts     PaymentAttempt[]

  @@unique([customerId, checkoutKey])
  @@index([expiresAt, paymentStatus])
  @@index([customerId])
  @@map("orders")
}

enum CancelledBy {
  CUSTOMER
  SELLER
  ADMIN
}

model ShopOrder {
  id           String          @id @default(uuid())
  orderId      String
  shopId       String
  status       ShopOrderStatus @default(PENDING)
  subtotal     Decimal         @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  shippingFee  Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount  Decimal         @default(0) @db.Decimal(12, 2)
  paidAmount   Decimal         @default(0) @db.Decimal(12, 2)
  deliveredAt  DateTime?
  carrier      String?
  trackingCode String?
  cancelReason String?
  cancelledBy  CancelledBy?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shop       Shop        @relation(fields: [shopId], references: [id])
  orderItems OrderItem[]
  history    OrderStatusHistory[]
  returnRequest ReturnRequest?
  refunds    Refund[]

  @@index([orderId])
  @@index([shopId])
  @@index([shopId, createdAt])
  @@index([deliveredAt])
  @@map("shop_orders")
}

model OrderItem {
  id           String  @id @default(uuid())
  shopOrderId  String
  productId    String
  variantId    String?
  variantSnapshot String?
  skuSnapshot String?
  nameSnapshot String
  unitPrice    Decimal @db.Decimal(12, 2)
  quantity     Int

  shopOrder ShopOrder @relation(fields: [shopOrderId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  reviews   Review[]

  @@index([shopOrderId])
  @@map("order_items")
}

model Payment {
  id          String        @id @default(uuid())
  orderId     String        @unique
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  momoTransId String?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Review {
  id          String   @id @default(uuid())
  productId   String
  customerId  String
  orderItemId String   @unique
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer  User      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  images    ReviewImage[]

  @@index([productId])
  @@map("reviews")
}

enum VoucherScope {
  PLATFORM
  SHOP
}

enum DiscountType {
  PERCENT
  FIXED
}

enum VoucherStatus {
  ACTIVE
  INACTIVE
}

model Voucher {
  id                String        @id @default(uuid())
  code              String        @unique
  scope             VoucherScope
  shopId            String?
  discountType      DiscountType
  discountValue     Decimal       @db.Decimal(12, 2)
  maxDiscountAmount Decimal?      @db.Decimal(12, 2)
  minOrderAmount    Decimal?      @db.Decimal(12, 2)
  usageLimit        Int?
  perUserLimit      Int?
  startAt           DateTime
  endAt             DateTime
  status            VoucherStatus @default(ACTIVE)
  createdAt         DateTime      @default(now())

  shop        Shop?               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  redemptions VoucherRedemption[]

  @@index([shopId])
  @@map("vouchers")
}

model VoucherRedemption {
  id        String   @id @default(uuid())
  voucherId String
  userId    String
  orderId   String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([voucherId])
  @@index([userId])
  @@map("voucher_redemptions")
}

enum ConversationType {
  DIRECT
  SUPPORT
}

model Conversation {
  id         String           @id @default(uuid())
  type       ConversationType
  customerId String
  shopId     String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  customer User      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  shop     Shop?     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([customerId, shopId, type])
  @@index([shopId])
  @@map("conversations")
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  body           String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@map("messages")
}

enum NotificationType {
  ORDER_STATUS_CHANGED
  NEW_MESSAGE
  SHOP_STATUS_CHANGED
  NEW_ORDER
  VOUCHER_NEW
  AD_STATUS_CHANGED
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

enum AdStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model Advertisement {
  id        String   @id @default(uuid())
  shopId    String
  title     String
  imageUrl  String
  linkUrl   String?
  status    AdStatus @default(PENDING)
  startAt   DateTime
  endAt     DateTime
  createdAt DateTime @default(now())
  deletionRequestedAt DateTime?
  deletionReason String?
  deletionReviewNote String?
  deletedAt DateTime?

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@map("advertisements")
}

model ProductVariant {
  id String @id @default(uuid())
  productId String
  sku String
  name String
  price Decimal @db.Decimal(12, 2)
  stock Int @default(0)
  isActive Boolean @default(true)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems CartItem[]
  orderItems OrderItem[]
  @@unique([productId, sku])
  @@map("product_variants")
}

model OrderStatusHistory {
  id String @id @default(uuid())
  shopOrderId String
  status ShopOrderStatus
  actorId String?
  note String?
  createdAt DateTime @default(now())
  shopOrder ShopOrder @relation(fields: [shopOrderId], references: [id], onDelete: Cascade)
  @@index([shopOrderId, createdAt])
  @@map("order_status_history")
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
}

model ReturnRequest {
  id String @id @default(uuid())
  shopOrderId String @unique
  reason String
  evidenceUrls String[]
  status ReturnStatus @default(REQUESTED)
  resolution String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shopOrder ShopOrder @relation(fields: [shopOrderId], references: [id])
  @@map("return_requests")
}

enum RefundStatus {
  PENDING
  COMPLETED
}

model Refund {
  id String @id @default(uuid())
  orderId String
  shopOrderId String? @unique
  amount Decimal @db.Decimal(12, 2)
  reason String
  status RefundStatus @default(PENDING)
  reference String?
  completedAt DateTime?
  createdAt DateTime @default(now())
  order Order @relation(fields: [orderId], references: [id])
  shopOrder ShopOrder? @relation(fields: [shopOrderId], references: [id])
  @@index([orderId])
  @@index([completedAt])
  @@map("refunds")
}

model PaymentAttempt {
  id String @id @default(uuid())
  orderId String
  providerOrderId String @unique
  requestId String @unique
  amount Decimal @db.Decimal(12, 2)
  payUrl String?
  resultCode String?
  transactionId String? @unique
  createdAt DateTime @default(now())
  order Order @relation(fields: [orderId], references: [id])
  @@index([orderId])
  @@map("payment_attempts")
}

model MediaAsset {
  id String @id @default(uuid())
  ownerId String
  mimeType String
  data Bytes
  createdAt DateTime @default(now())
  reviewImages ReviewImage[]
  @@index([ownerId])
  @@map("media_assets")
}

model ReviewImage {
  reviewId String
  assetId String
  sortOrder Int @default(0)
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  asset MediaAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  @@id([reviewId, assetId])
  @@index([assetId])
  @@map("review_images")
}

model WishlistItem {
  userId String
  productId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@id([userId, productId])
  @@index([userId, createdAt])
  @@index([productId])
  @@map("wishlist_items")
}
