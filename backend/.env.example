DATABASE_URL=postgresql://postgres:your-password@127.0.0.1:5432/ecom_db
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
PORT=3000
NODE_ENV=development
# Demo data is inserted before start:prod; false disables that step.
SEED_DEMO_DATA=true
# Optional absolute URL for uploaded media when behind a custom proxy:
PUBLIC_API_URL=http://localhost:3000/api
MOMO_PARTNER_CODE=your-sandbox-partner-code
MOMO_ACCESS_KEY=your-sandbox-access-key
MOMO_SECRET_KEY=your-sandbox-secret-key
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:5173/payment/momo/return
MOMO_IPN_URL=https://your-public-backend.example/api/payments/momo/ipn
